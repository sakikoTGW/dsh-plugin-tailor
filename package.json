{
  "name": "dsh-plugin-tailor",
  "version": "0.5.1",
  "description": "Tailor a repository to fit: audit it across 8 dimensions / 44 checks, pick or author a structured README style with three layout engines, draft a bilingual README, generate a deterministic 12-file brand kit with WCAG contrast QA, and verify links before publishing.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./styles/*": "./styles/*"
  },
  "bin": {
    "dsh-repo-tailor": "./bin/tailor.mjs"
  },
  "files": [
    "index.js",
    "host",
    "logic",
    "bin",
    "styles",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "BENCHMARK.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PUBLISHING.md",
    "docs",
    "assets"
  ],
  "scripts": {
    "test": "node --test test/tailor.test.mjs",
    "tailor": "node bin/tailor.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "readme",
    "repository",
    "maturity",
    "branding",
    "audit"
  ],
  "author": "sakikoTGW",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakikoTGW/dsh-plugin-tailor.git"
  },
  "homepage": "https://github.com/sakikoTGW/dsh-plugin-tailor#readme",
  "bugs": {
    "url": "https://github.com/sakikoTGW/dsh-plugin-tailor/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
